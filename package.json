{
  "name": "orca-financial",
  "version": "1.0.0",
  "private": true,
  "description": "Orca Financial (Full Option) — Nền tảng Phân tích Tài chính Toàn diện Đa tài sản, Định lượng & Trợ lý Trí tuệ Nhân tạo Orca AI",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:all": "tsx server/index.ts",
    "server:hono": "tsx server/index.ts",
    "dev:vite": "vite --port 3000",
    "build:vite": "vite build",
    "preview:vite": "vite preview --port 3000",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "prod": "vite build && tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test src/lib/__tests__/pillar*.test.ts src/lib/__tests__/security-audit.test.ts",
    "test:quant": "tsx --conditions=react-server --test src/lib/__tests__/real-market-end-to-end.test.ts src/lib/__tests__/formulaic-alpha-qlib.test.ts src/lib/__tests__/alpha-decay-monitor.test.ts src/lib/__tests__/arctic-timeseries-engine.test.ts src/lib/__tests__/institutional-greeks-gsquant.test.ts src/lib/__tests__/institutional-valuation-suite.test.ts src/lib/__tests__/prediction-market-radar.test.ts src/lib/__tests__/ai-investment-committee.test.ts src/lib/__tests__/bot-*.test.ts src/lib/__tests__/data-integrity-audit.test.ts src/lib/__tests__/quant-suite-integration.test.ts src/lib/engines/__tests__/*.test.ts",
    "test:live": "tsx --conditions=react-server --test src/lib/__tests__/real-market-end-to-end.test.ts",
    "test:snapshot": "tsx scripts/snapshot-real-test-data.ts",
    "test:all": "tsx --conditions=react-server --test src/lib/__tests__/*.test.ts src/lib/engines/__tests__/*.test.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@hono/node-server": "^2.1.8",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "apache-arrow": "^21.2.0",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.18",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.13.0",
    "pg": "8.20.0",
    "postcss": "8.5.29",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "swr": "^2.3.3",
    "tailwindcss": "4.1.17",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "esbuild": "^0.25.0"
  }
}
