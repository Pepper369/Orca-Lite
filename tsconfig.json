{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "server-only": [
        "./src/lib/shims/server-only.ts"
      ],
      "next": [
        "./src/lib/shims/next-types.ts"
      ],
      "next/server": [
        "./src/lib/shims/next-server.ts"
      ],
      "next/headers": [
        "./src/lib/shims/next-headers.ts"
      ],
      "next/og": [
        "./src/lib/shims/next-og.ts"
      ],
      "next/link": [
        "./src/lib/shims/next-link.tsx"
      ],
      "next/navigation": [
        "./src/lib/shims/next-navigation.tsx"
      ],
      "next/dynamic": [
        "./src/lib/shims/next-dynamic.tsx"
      ],
      "next/image": [
        "./src/lib/shims/next-image.tsx"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "drizzle.config.ts",
    "open-next.config.ts",
    "src/lib/__tests__",
    "**/*.test.ts"
  ]
}
