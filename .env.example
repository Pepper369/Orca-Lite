# ==============================================================================
# ORCA Financial Lite — Environment Template (.env.example)
# Optimized for Google AI Studio (Gemini 2.0 Flash) & Lightweight Run
# ==============================================================================

# 1. AI Intelligence (Google AI Studio - Free API Key at https://aistudio.google.com/)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
AI_MODEL=gemini-2.0-flash

# 2. Database & Convex Realtime (Optional - In-memory mock will be used if unset)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# 3. Security & System
JWT_SECRET=
CRON_SECRET=
NEXT_TELEMETRY_DISABLED=1

# 4. Market Data Providers (Optional - Public fallbacks exist in code)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
VNSTOCK_API_KEY=
SIMPLIZE_API_KEY=
COINGECKO_PRO_API_KEY=
POLYGON_API_KEY=
